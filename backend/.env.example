# --- Database (MySQL) ---
DB_USER=sms_user
DB_PASSWORD=sms_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tucode_sms
# Or override everything with a full URL:
# DATABASE_URL=mysql+pymysql://sms_user:sms_password@127.0.0.1:3306/tucode_sms?charset=utf8mb4

# --- Security (CHANGE THESE) ---
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# --- App ---
# Public URL of the React app (used inside QR codes for receipt/certificate verification)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Set to 0 to disable the automatic daily reminder scheduler
ENABLE_SCHEDULER=1
REMINDER_HOUR=8

# --- First admin account (created by `python seed.py`) ---
ADMIN_EMAIL=admin@tucode.ac.ke
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator
